# copy to .env - never commit .env
# the values below are for the local Docker setup only
STEAM_APP_ID=1245620
REVIEW_LANGUAGE=english

# POSTGRES_HOST: localhost from your machine, "postgres" from inside a container
POSTGRES_USER=rage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rage_index
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=8080

# Kestra UI login: the user must be an email, the password needs 8+ characters with an uppercase letter and a number
KESTRA_USER=admin@example.com
KESTRA_PASSWORD=Change-me1
KESTRA_PORT=8090
